# ── Google OAuth 2.0 ──────────────────────────────────────────────────────────
# 取得手順:
#   1. https://console.cloud.google.com/ でプロジェクトを作成（または既存を選択）
#   2. 「APIとサービス」→「認証情報」→「OAuthクライアントID」を作成
#      種類: ウェブアプリケーション
#      承認済みJavaScriptオリジン: http://localhost:5000
#      承認済みリダイレクトURI: 不要（GIS ライブラリはフロントエンド完結）
#   3. クライアントID と クライアントシークレット をコピーして貼り付け
GOOGLE_CLIENT_ID=xxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxx

# ── Flask ─────────────────────────────────────────────────────────────────────
# ランダムな文字列を設定してください（セッションの暗号化に使用）
# 生成例: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=your-random-secret-key-here
# デバッグモード（本番では false に）
FLASK_DEBUG=false

# ── Google Maps API キー ───────────────────────────────────────────────────────
# 有効にする API: Maps JavaScript API / Geocoding API / Places API
# 取得: https://console.cloud.google.com/
GOOGLE_MAPS_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Anthropic Claude API キー ─────────────────────────────────────────────────
# 取得: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx

# ── (任意) データベース ────────────────────────────────────────────────────────
# 未設定の場合は instagram_map.db (SQLite) を使用
# PostgreSQL を使う場合: DATABASE_URL=postgresql://user:pass@host:5432/dbname
# DATABASE_URL=

# ── Gmail メール送信（グループ招待機能）────────────────────────────────────────
# 招待メールの送信に使うアプリ専用の Gmail アカウント。
# 個人アカウントとは別に専用アカウント（例: myapp.noreply@gmail.com）を作成し、
# そのアカウントのアプリパスワードを設定することを推奨します。
#
# アプリパスワードの取得手順:
#   1. https://myaccount.google.com/security で「2段階認証」を有効化
#   2. https://myaccount.google.com/apppasswords でアプリパスワードを生成
#      アプリ名: 任意（例: InstagramMap）
#   3. 生成された16文字のパスワードを GMAIL_APP_PASSWORD に設定
GMAIL_USER=instagrammap.app@gmail.com
GMAIL_APP_PASSWORD=gysxbpikyxgiwqhe

# ── (レガシー・バッチ単体実行用) Instagram 認証情報 ───────────────────────────
# batch/main.py を直接実行する場合のみ必要。
# Webアプリ経由では使用しない（ユーザーがブラウザからログインする）。
# INSTAGRAM_USERNAME=your_email@example.com
# INSTAGRAM_PASSWORD=your_password
# INSTAGRAM_HANDLE=your_instagram_handle
