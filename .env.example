# Instagram 認証情報
# INSTAGRAM_USERNAME: ログインに使うメールアドレスまたはユーザー名
INSTAGRAM_USERNAME=your_email@example.com
INSTAGRAM_PASSWORD=your_password

# Instagram プロフィールのユーザー名（@ハンドル）
# 例: Instagramのプロフィールページが https://www.instagram.com/soccer_player123/ なら
#     INSTAGRAM_HANDLE=soccer_player123
# ※ メールアドレスでログインしている場合は必ずこの設定が必要です
INSTAGRAM_HANDLE=your_instagram_handle

# Anthropic Claude API キー
# 取得: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx

# Google Maps API キー（Maps JavaScript API + Geocoding API を有効化）
# 取得: https://console.cloud.google.com/
GOOGLE_MAPS_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
